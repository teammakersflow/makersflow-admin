# ── Backend API ───────────────────────────────────────────────────────────
# NestJS backend base URL, no trailing slash.
# Production: https://api.makersflow.in
# Local backend: http://localhost:4000  (the backend defaults to PORT=3000,
# which collides with Next.js — run it on another port and match it here)
NEXT_PUBLIC_API_URL=https://api.makersflow.in

# ── Google sign-in ────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials.
# Only the Client ID is used. The Client Secret is NOT needed: the browser
# uses Google Identity Services and the backend verifies the ID token
# against this same client ID.
# Every origin that serves this app must be listed under "Authorized
# JavaScript origins" for this client (e.g. http://localhost:3000).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── File uploads ──────────────────────────────────────────────────────────
# The backend's /storage/upload-url returns only { uploadUrl, key } — no
# public URL — so the frontend builds it from this base. Must be the public
# base of the same bucket the backend uploads to, or saved image URLs break.
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=https://your-bucket.s3.ap-south-1.amazonaws.com
